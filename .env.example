APP_NAME="Pasigna Dental Clinic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
CLINIC_PUBLIC_PHONE=
CLINIC_PUBLIC_EMAIL=
CLINIC_PUBLIC_ADDRESS=
CLINIC_PUBLIC_HOURS=
# Set in production when behind reverse proxy/load balancer.
# Example: TRUSTED_PROXIES=10.0.0.1,10.0.0.2 or TRUSTED_PROXIES=*
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pasigna_dental_clinic
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_COOKIE=pasigna_dental_clinic_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Optional: use a path within this project's storage for patient files.
# PATIENT_PRIVATE_ROOT=C:/xampp/htdocs/pasigna-dental-clinic/storage/app/private/patients
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_BOOKINGS_TO=
MAIL_FROM_ADDRESS="noreply@pasigna.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Staff records assistant: rules works without a model or paid API.
# Set provider to ollama to classify questions using a server-reachable Ollama instance.
STAFF_ASSISTANT_PROVIDER=rules
STAFF_ASSISTANT_OLLAMA_URL=http://127.0.0.1:11434
STAFF_ASSISTANT_OLLAMA_MODEL=llama3.2:3b

# Optional local seed credentials (only used in local/testing)
# SEED_ADMIN_EMAIL=admin@pasigna.test
# SEED_ADMIN_PASSWORD=change-me
# SEED_STAFF_EMAIL=staff@pasigna.test
# SEED_STAFF_PASSWORD=change-me
